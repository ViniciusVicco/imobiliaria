{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "front-end-local",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port",
        "8080"
      ]
    },
    {
      "name": "back-end-local",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "local-full-stack",
      "configurations": [
        "back-end-local",
        "front-end-local"
      ]
    }
  ]
}
