{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "front-end-local",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port",
        "8080",
        "--dart-define=API_BASE_URL=http://localhost:3333/api/v1"
      ]
    },
    {
      "name": "back-end-local",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "seletta-go-live",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "https://another-absently-blunt.ngrok-free.dev",
      "webRoot": "${workspaceFolder}/build/web",
      "preLaunchTask": "seletta-go-live: start"
    }
  ],
  "compounds": [
    {
      "name": "local-full-stack",
      "configurations": [
        "back-end-local",
        "front-end-local"
      ]
    }
  ]
}
