DATABASE_URL="postgresql://admin_local:local_dev_password@localhost:5432/seletta_local?schema=public"
SHADOW_DATABASE_URL="postgresql://admin_local:local_dev_password@localhost:5432/seletta_shadow?schema=public"
PORT=3333
CORS_ORIGIN="http://localhost:8080"
JWT_SECRET="seletta-local-development-jwt-secret-change-me"
JWT_EXPIRES_IN_SECONDS=28800
FIRST_ADMIN_EMAIL="admin@seletta.local"
FIRST_ADMIN_PASSWORD="AdminLocal123!"
FIRST_ADMIN_NAME="Admin Local"
GMAIL_SMTP_SECRET=""
GMAIL_SMTP_USER="selettawebsite@gmail.com"
GMAIL_SMTP_FROM="Seletta"

# Cloudflare R2 account id. Found in the Cloudflare dashboard URL/account details.
R2_ACCOUNT_ID=""

# Cloudflare R2 bucket name used to store property media.
R2_BUCKET_NAME=""

# Cloudflare R2 Access Key ID. Use the S3-compatible R2 key, not the API token value.
R2_ACCESS_KEY_ID=""

# Cloudflare R2 Secret Access Key. Keep this private and never commit real values.
R2_SECRET_ACCESS_KEY=""

# Public base URL used to serve uploaded files, for example a custom domain or public bucket URL.
R2_PUBLIC_BASE_URL=""

# S3-compatible endpoint for the account. Replace <ACCOUNT_ID> with R2_ACCOUNT_ID.
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

# R2 S3-compatible region. Cloudflare uses "auto".
R2_REGION="auto"

# Maximum accepted image size in megabytes.
R2_MAX_IMAGE_SIZE_MB=10

# Comma-separated list of image MIME types accepted by the upload endpoint.
R2_ALLOWED_IMAGE_MIME_TYPES="image/jpeg,image/png,image/webp"

# Cloudflare API Token value is intentionally not used by the app runtime.
# Use it only for future Cloudflare administrative automation, if needed.
